# Dev-only: where the Vite dev server proxies /api requests to the backend.
# Must match PORT in server/.env. Only used while VITE_API_URL below is empty.
VITE_API_PROXY_TARGET=http://localhost:5000

# Absolute backend URL. Leave empty in development so requests stay on the same
# origin and go through the proxy above.
#
# Set this when the dev server and the API are on different machines, e.g. the
# client under WSL and the API on Windows. WSL cannot route to the Windows host,
# so the proxy is refused, but the browser reaches the API directly and the
# server's CORS headers allow it.
VITE_API_URL=

# Port for the Vite dev server (default 5173)
CLIENT_PORT=5173

# Outbound email is configured in server/.env.example, not here — it belongs to
# the API process (MAIL_USER / MAIL_PASS, Gmail App Password).
