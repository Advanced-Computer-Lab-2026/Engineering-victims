# Dev-only: where the Vite dev server proxies /api requests to the backend.
# Must match PORT in server/.env
VITE_API_PROXY_TARGET=http://localhost:5000

# Absolute backend URL, used for production builds only.
# Leave empty in development so requests stay on the same origin.
VITE_API_URL=

# Port for the Vite dev server (default 5173)
CLIENT_PORT=5173
