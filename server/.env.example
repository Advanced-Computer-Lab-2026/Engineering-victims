# FR 116: Google Calendar. See docs/calendar-integrations.md for Cloud Console setup.
# The redirect must exactly match the student application's /schedule URL.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/schedule
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this stable and private; changing it requires reconnecting Google accounts.
CALENDAR_TOKEN_KEY=
UNIVERSITY_TIMEZONE=Africa/Cairo

# Port for the API server. The Vite dev proxy in ../.env must match this.
PORT=5000

# MongoDB target. Uncomment ONE — the last uncommented MONGODB_URI wins.
#
# Atlas (default) — cloud DB. Only whitelisted IPs can reach it; if you get an
# IP whitelist error, add your IP (or 0.0.0.0/0) under Network Access, or
# switch to the local one below.
MONGODB_URI=mongodb+srv://samymostafax_db_user:MWoQ13uJftdTSQJH@users.vbneqmq.mongodb.net/university_schedule?retryWrites=true&w=majority

# Local (backup) — start a local mongod first, e.g.
#   mongod --dbpath ~/mongodb/data
# MONGODB_URI=mongodb://127.0.0.1:27017/university_schedule

# Replace with a long random string. `npm run setup` generates one for you.
JWT_SECRET=your_super_secret_jwt_key_here

NODE_ENV=development

# --- Outbound email (Gmail SMTP) -------------------------------------------
# MAIL_USER is the shared team mailbox, committed so every teammate gets a
# working mailbox without a setup step. MAIL_PASS is NOT committed: copy it
# into server/.env from your team's shared notes, or email stays disabled.
#
# MAIL_PASS is a 16-character Gmail APP PASSWORD, not the account password.
# Google refuses plain account passwords on SMTP. Generate one at
# https://myaccount.google.com/apppasswords (2-Step Verification must be on).
# Spaces are ignored — either format works.
#
# If these are blank, the app still runs: forgot-password prints the OTP to the
# server console and every other email is skipped with a warning.
MAIL_USER=engineeringvictims1@gmail.com
MAIL_PASS=
